{
  "name": "jarvis-enterprise",
  "version": "2.1.0",
  "description": "J.A.R.V.I.S. Mark VII - Just A Rather Very Intelligent System - Complete AI Assistant Platform",
  "main": "app.js",
  "bin": {
    "jarvis": "./jarvis-cli.js"
  },
  "scripts": {
    "install:setup": "node install.js",
    "init": "node jarvis-init.js",
    "start": "node app.js",
    "cli": "node jarvis-cli.js",
    "safe": "node --expose-gc jarvis-safe.js",
    "protected": "node start-protected.js",
    "jarvis": "node jarvis-complete.js",
    "autonomous": "node test-autonomous-agent.js",
    "web-intel": "node test-web-intelligence.js",
    "pure": "node jarvis-pure-start.js",
    "pure:memory": "node core/jarvis-with-memory.cjs",
    "proactive": "node jarvis-proactive.cjs",
    "complete": "node main-complete.js",
    "fase7": "node main-fase7.js",
    "ultimate": "node main-ultimate.js",
    "remote": "node remote-server.js",
    "dev": "nodemon app.js",
    "dev:pure": "nodemon jarvis-pure-start.js",
    "clean": "rm -rf logs/* memory/*.db",
    "clean:all": "rm -rf logs/* memory/*.db node_modules",
    "test": "jest tests/unit",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:e2e": "jest tests/e2e",
    "test:watch": "jest --watch",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "jest --coverage --collectCoverageFrom='core/**/*.js'",
    "lint": "eslint . --ext .js,.jsx,.cjs",
    "lint:fix": "eslint . --ext .js,.jsx,.cjs --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "memory": "node core/auto-memory-logger.cjs",
    "memory:test": "node test-auto-memory.cjs",
    "memory:view": "cat memory/context/CURRENT-STATE.json",
    "memory:today": "cat memory/daily/$(date +%Y-%m-%d).md",
    "memory:update-context": "node core/update-claude-context.cjs",
    "migrate": "node -e \"require('./core/database-migrator').migrate()\"",
    "migrate:rollback": "node -e \"require('./core/database-migrator').rollback()\"",
    "migrate:status": "node -e \"require('./core/database-migrator').status()\"",
    "backup": "node -e \"require('./core/backup-manager').createBackup()\"",
    "backup:restore": "node -e \"require('./core/backup-manager').restore()\"",
    "update:check": "node -e \"require('./core/auto-updater').checkForUpdates()\"",
    "update:install": "node -e \"require('./core/auto-updater').installUpdate()\"",
    "panel": "node web-interface/start-protected-panel.js",
    "demo": "node demo-interactive.js",
    "demo:auto": "node demo-auto.js",
    "demo:all": "node demo-all-systems.js",
    "build": "echo 'Build process - add custom build steps here'",
    "build:frontend": "cd web-interface/frontend && npm run build",
    "build:docker": "docker-compose build",
    "deploy": "echo 'Deploy process - configure deployment target'",
    "deploy:production": "pm2 start app.js --name jarvis-production",
    "deploy:stop": "pm2 stop jarvis-production",
    "deploy:restart": "pm2 restart jarvis-production",
    "deploy:logs": "pm2 logs jarvis-production",
    "metrics": "node -e \"require('./core/metrics-collector').getMetricsCollector().start()\"",
    "health": "curl http://localhost:7777/health",
    "logs:view": "tail -f logs/combined-*.log",
    "logs:errors": "tail -f logs/error-*.log",
    "logs:clean": "node -e \"require('./core/logger').getLogger().cleanup()\"",
    "prepare": "echo 'Prepare hook - runs before npm publish'",
    "prepublishOnly": "npm run test && npm run lint",
    "postinstall": "echo '\\n✅ JARVIS installed! Run: npm run install:setup\\n'"
  },
  "keywords": [
    "jarvis",
    "ai",
    "butler",
    "automation"
  ],
  "author": "Enterprise AI Systems",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.30",
    "@anthropic-ai/sdk": "^0.30.1",
    "@octokit/rest": "^20.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "body-parser": "^2.2.0",
    "cheerio": "^1.1.2",
    "chokidar": "^4.0.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "inquirer": "^12.10.0",
    "jsonwebtoken": "^9.0.2",
    "mkdirp": "^3.0.1",
    "mysql2": "^3.6.0",
    "ncp": "^2.0.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.29.1",
    "react-router-dom": "^7.11.0",
    "simple-git": "^3.20.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.2",
    "sqlite3": "^5.1.6",
    "ssh2": "^1.14.0",
    "systeminformation": "^5.27.11",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "acorn": "^8.15.0",
    "c8": "^10.1.3",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.1.4"
  },
  "optionalDependencies": {
    "@google-cloud/speech": "^7.2.1",
    "@pinecone-database/pinecone": "^6.1.3",
    "googleapis": "^164.1.0",
    "node-record-lpcm16": "^1.0.1",
    "nodemailer": "^7.0.10",
    "spotify-web-api-node": "^5.0.2",
    "vosk": "^0.3.39"
  }
}
