# ============================================
# JARVIS Backend - Multi-stage Docker Build
# ============================================

# Stage 1: Base image with dependencies
FROM node:22-alpine AS base
LABEL maintainer="JARVIS Enterprise"
LABEL description="JARVIS Mark VII Backend Service"

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    curl \
    && rm -rf /var/cache/apk/*

# Copy package files
COPY package*.json ./
COPY web-interface/backend/package*.json ./web-interface/backend/

# Stage 2: Development dependencies
FROM base AS development
ENV NODE_ENV=development

RUN npm ci && \
    cd web-interface/backend && npm ci

COPY . .

EXPOSE 7777
CMD ["npm", "run", "panel"]

# Stage 3: Production build
FROM base AS builder
ENV NODE_ENV=production

# Install production dependencies only
RUN npm ci --only=production && \
    cd web-interface/backend && npm ci --only=production

COPY . .

# Stage 4: Production image
FROM node:22-alpine AS production
ENV NODE_ENV=production
ENV PORT=7777

WORKDIR /app

# Copy only necessary files from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/core ./core
COPY --from=builder /app/web-interface/backend ./web-interface/backend
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/*.js ./
COPY --from=builder /app/*.md ./

# Create non-root user
RUN addgroup -g 1001 -S jarvis && \
    adduser -S jarvis -u 1001

# Create necessary directories with correct permissions
RUN mkdir -p /app/logs /app/memory /app/metrics /app/data && \
    chown -R jarvis:jarvis /app

USER jarvis

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:7777/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

EXPOSE 7777

# Start application
CMD ["node", "web-interface/backend/server.cjs"]
