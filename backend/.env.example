# Database PostgreSQL EMBEBIDO
# Configura estas variables antes de ejecutar init-db.bat
PGUSER=pos_admin
PGPASSWORD=CAMBIAR_ESTE_PASSWORD
PGPORT=5433
DATABASE_URL="postgresql://pos_admin:CAMBIAR_ESTE_PASSWORD@localhost:5433/pos_db"

# MySQL Legacy (READ ONLY)
