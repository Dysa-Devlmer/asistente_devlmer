# ============================================================================
# SYSME TPV Backend - Variables de Entorno
# ============================================================================

# Servidor
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=sysme_user
DB_PASSWORD=sysme_password_2025
DB_NAME=sysme_tpv

# JWT (para autenticación futura)
JWT_SECRET=change-this-in-production-use-random-string-minimum-32-characters

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_PORT=3001
