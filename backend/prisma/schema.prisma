// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrderStatus {
  open
  sent_to_kitchen
  in_preparation
  ready
  delivered
  closed
  cancelled
}

enum OrderItemStatus {
  pending
  sent_to_kitchen
  in_preparation
  ready
  delivered
  cancelled
}

enum KitchenQueueStatus {
  pending
  in_preparation
  ready
  delivered
}

enum TableStatus {
  available
  occupied
  reserved
  out_of_service
}

enum ShiftStatus {
  open
  closed
}

enum DrawerEventType {
  opening
  withdrawal
  addition
  change_given
  other
}

enum DocumentType {
  ticket
  boleta
  factura
}

enum EmployeeRole {
  waiter
  cashier
  cook
  bartender
  manager
  admin
}

enum CustomerDocumentType {
  dni
  ruc
  passport
  other
}

// ============================================================
// DOMINIO 1: VENTAS / COMANDAS
// ============================================================

model Order {
  id                   BigInt       @id @default(autoincrement())
  legacyId             BigInt?      @map("legacy_id")  // ID original del sistema legacy
  orderNumber          String       @unique @map("order_number") @db.VarChar(20)

  // Relaciones
  tableId              BigInt       @map("table_id")
  table                Table        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  waiterId             BigInt       @map("waiter_id")
  waiter               Employee     @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: Restrict)
  shiftId              BigInt       @map("shift_id")
  shift                CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  // Información de la orden
  guestCount           Int          @default(1) @map("guest_count") @db.SmallInt
  status               OrderStatus  @default(open)

  // Totales
  subtotal             Decimal      @default(0.00) @db.Decimal(10, 2)
  taxAmount            Decimal      @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount       Decimal      @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount          Decimal      @default(0.00) @map("total_amount") @db.Decimal(10, 2)

  // Metadatos
  notes                String?      @db.Text
  openedAt             DateTime     @map("opened_at")
  sentToKitchenAt      DateTime?    @map("sent_to_kitchen_at")
  closedAt             DateTime?    @map("closed_at")
  cancelledAt          DateTime?    @map("cancelled_at")
  cancellationReason   String?      @map("cancellation_reason") @db.Text

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  // Relaciones inversas
  orderItems           OrderItem[]
  payments             Payment[]
  invoices             Invoice[]
  tablesCurrent        Table[]      @relation("CurrentOrder")

  @@index([status])
  @@index([tableId])
  @@index([waiterId])
  @@index([shiftId])
  @@index([openedAt])
  @@map("orders")
}

model OrderItem {
  id                   BigInt           @id @default(autoincrement())
  legacyId             BigInt?          @map("legacy_id")

  // Relaciones
  orderId              BigInt           @map("order_id")
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            BigInt           @map("product_id")
  product              Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Información del item
  quantity             Decimal          @default(1.000) @db.Decimal(8, 3)
  unitPrice            Decimal          @map("unit_price") @db.Decimal(10, 2)
  subtotal             Decimal          @db.Decimal(10, 2)
  discountPercentage   Decimal          @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount       Decimal          @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount          Decimal          @map("total_amount") @db.Decimal(10, 2)

  // Metadatos
  notes                String?          @db.Text
  status               OrderItemStatus  @default(pending)

  sentToKitchenAt      DateTime?        @map("sent_to_kitchen_at")
  preparedAt           DateTime?        @map("prepared_at")
  deliveredAt          DateTime?        @map("delivered_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  cancellationReason   String?          @map("cancellation_reason") @db.Text

  // Timestamps
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  // Relaciones inversas
  kitchenQueue         KitchenQueue[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([legacyId])
  @@map("order_items")
}

model KitchenQueue {
  id                   BigInt             @id @default(autoincrement())

  // Relaciones
  orderItemId          BigInt             @map("order_item_id")
  orderItem            OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stationId            BigInt             @map("station_id")
  station              KitchenStation     @relation(fields: [stationId], references: [id], onDelete: Restrict)

  // Información
  priority             Int                @default(5) @db.SmallInt
  status               KitchenQueueStatus @default(pending)

  assignedAt           DateTime?          @map("assigned_at")
  startedAt            DateTime?          @map("started_at")
  completedAt          DateTime?          @map("completed_at")

  // Timestamps
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([stationId])
  @@index([priority])
  @@map("kitchen_queue")
}

model KitchenStation {
  id                   BigInt         @id @default(autoincrement())

  name                 String         @db.VarChar(100)
  code                 String         @unique @db.VarChar(20)
  description          String?        @db.Text
  isActive             Boolean        @default(true) @map("is_active")
  displayOrder         Int            @default(0) @map("display_order")

  // Timestamps
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  // Relaciones inversas
  kitchenQueue         KitchenQueue[]

  @@index([isActive])
  @@map("kitchen_stations")
}

// ============================================================
// DOMINIO 2: PRODUCTOS & CATEGORÍAS
// ============================================================

model Product {
  id                   BigInt          @id @default(autoincrement())
  legacyId             BigInt?         @map("legacy_id")
  legacySku            String?         @map("legacy_sku") @db.VarChar(50)

  // Relaciones
  categoryId           BigInt          @map("category_id")
  category             Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Información básica
  sku                  String          @unique @db.VarChar(50)
  name                 String          @db.VarChar(200)
  description          String?         @db.Text

  // Precios
  basePrice            Decimal         @map("base_price") @db.Decimal(10, 2)
  costPrice            Decimal         @default(0.00) @map("cost_price") @db.Decimal(10, 2)

  // Control
  isActive             Boolean         @default(true) @map("is_active")
  isTaxable            Boolean         @default(true) @map("is_taxable")
  taxRate              Decimal         @default(18.00) @map("tax_rate") @db.Decimal(5, 2)

  // Inventario
  tracksInventory      Boolean         @default(false) @map("tracks_inventory")
  currentStock         Decimal         @default(0.000) @map("current_stock") @db.Decimal(10, 3)
  minStock             Decimal         @default(0.000) @map("min_stock") @db.Decimal(10, 3)

  // Metadatos
  imageUrl             String?         @map("image_url") @db.VarChar(500)
  preparationTime      Int?            @map("preparation_time")
  displayOrder         Int             @default(0) @map("display_order")

  // Timestamps
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  deletedAt            DateTime?       @map("deleted_at")

  // Relaciones inversas
  orderItems           OrderItem[]
  productPrices        ProductPrice[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@index([legacyId])
  @@index([legacySku])
  @@map("products")
}

model Category {
  id                   BigInt       @id @default(autoincrement())
  legacyCode           String?      @map("legacy_code") @db.VarChar(20)

  // Jerarquía (opcional)
  parentId             BigInt?      @map("parent_id")
  parent               Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  // Información
  code                 String       @unique @db.VarChar(20)
  name                 String       @db.VarChar(100)
  description          String?      @db.Text

  // Control
  isActive             Boolean      @default(true) @map("is_active")
  displayOrder         Int          @default(0) @map("display_order")

  // Metadatos
  icon                 String?      @db.VarChar(100)
  color                String?      @db.VarChar(20)

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  // Relaciones inversas
  products             Product[]
  subcategories        Category[]   @relation("CategoryHierarchy")

  @@index([parentId])
  @@index([isActive])
  @@index([legacyCode])
  @@map("categories")
}

model PriceTier {
  id                   BigInt          @id @default(autoincrement())
  legacyCode           String?         @map("legacy_code") @db.VarChar(20)

  code                 String          @unique @db.VarChar(20)
  name                 String          @db.VarChar(100)
  description          String?         @db.Text

  isDefault            Boolean         @default(false) @map("is_default")
  isActive             Boolean         @default(true) @map("is_active")
  displayOrder         Int             @default(0) @map("display_order")

  // Timestamps
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  deletedAt            DateTime?       @map("deleted_at")

  // Relaciones inversas
  productPrices        ProductPrice[]

  @@index([isDefault])
  @@index([isActive])
  @@index([legacyCode])
  @@map("price_tiers")
}

model ProductPrice {
  id                   BigInt       @id @default(autoincrement())

  // Relaciones
  productId            BigInt       @map("product_id")
  product              Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceTierId          BigInt       @map("price_tier_id")
  priceTier            PriceTier    @relation(fields: [priceTierId], references: [id], onDelete: Cascade)

  // Precio
  price                Decimal      @db.Decimal(10, 2)

  // Vigencia (opcional)
  validFrom            DateTime?    @map("valid_from") @db.Date
  validUntil           DateTime?    @map("valid_until") @db.Date

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@unique([productId, priceTierId], name: "unique_product_tier")
  @@index([productId])
  @@index([priceTierId])
  @@map("product_prices")
}

// ============================================================
// DOMINIO 3: MESAS & SALONES
// ============================================================

model Table {
  id                   BigInt       @id @default(autoincrement())
  legacyTableNumber    String?      @map("legacy_table_number") @db.VarChar(20)

  // Relaciones
  roomId               BigInt       @map("room_id")
  room                 Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)

  // Información
  tableNumber          String       @map("table_number") @db.VarChar(20)
  capacity             Int          @default(4)

  // Estado
  status               TableStatus  @default(available)
  currentOrderId       BigInt?      @unique @map("current_order_id")
  currentOrder         Order?       @relation("CurrentOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)

  // Control
  isActive             Boolean      @default(true) @map("is_active")
  displayOrder         Int          @default(0) @map("display_order")

  // Metadatos
  notes                String?      @db.Text

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  // Relaciones inversas
  orders               Order[]

  @@unique([roomId, tableNumber], name: "unique_room_table")
  @@index([status])
  @@index([roomId])
  @@index([legacyTableNumber])
  @@map("tables")
}

model Room {
  id                   BigInt       @id @default(autoincrement())
  legacyCode           String?      @map("legacy_code") @db.VarChar(20)

  code                 String       @unique @db.VarChar(20)
  name                 String       @db.VarChar(100)
  description          String?      @db.Text

  capacity             Int          @default(0)
  isActive             Boolean      @default(true) @map("is_active")
  displayOrder         Int          @default(0) @map("display_order")

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  // Relaciones inversas
  tables               Table[]

  @@index([isActive])
  @@index([legacyCode])
  @@map("rooms")
}

// ============================================================
// DOMINIO 4: CAJA & PAGOS
// ============================================================

model CashRegister {
  id                   BigInt                @id @default(autoincrement())
  legacyId             BigInt?               @map("legacy_id")

  code                 String                @unique @db.VarChar(20)
  name                 String                @db.VarChar(100)
  description          String?               @db.Text

  isActive             Boolean               @default(true) @map("is_active")

  // Timestamps
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")

  // Relaciones inversas
  shifts               CashRegisterShift[]

  @@index([isActive])
  @@index([legacyId])
  @@map("cash_registers")
}

model CashRegisterShift {
  id                   BigInt       @id @default(autoincrement())
  legacyId             BigInt?      @map("legacy_id")

  // Relaciones
  cashRegisterId       BigInt       @map("cash_register_id")
  cashRegister         CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedByUserId       BigInt       @map("opened_by_user_id")
  openedByUser         Employee     @relation("ShiftsOpened", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedByUserId       BigInt?      @map("closed_by_user_id")
  closedByUser         Employee?    @relation("ShiftsClosed", fields: [closedByUserId], references: [id], onDelete: Restrict)

  // Montos de apertura
  openingCash          Decimal      @map("opening_cash") @db.Decimal(10, 2)
  openingNotes         String?      @map("opening_notes") @db.Text

  // Montos de cierre
  closingCash          Decimal?     @map("closing_cash") @db.Decimal(10, 2)
  closingCards         Decimal?     @map("closing_cards") @db.Decimal(10, 2)
  closingOther         Decimal?     @map("closing_other") @db.Decimal(10, 2)
  closingTotal         Decimal?     @map("closing_total") @db.Decimal(10, 2)

  expectedCash         Decimal?     @map("expected_cash") @db.Decimal(10, 2)
  cashDifference       Decimal?     @map("cash_difference") @db.Decimal(10, 2)
  closingNotes         String?      @map("closing_notes") @db.Text

  // Estado
  status               ShiftStatus  @default(open)

  // Fechas
  openedAt             DateTime     @map("opened_at")
  closedAt             DateTime?    @map("closed_at")

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relaciones inversas
  orders               Order[]
  payments             Payment[]
  cashDrawerEvents     CashDrawerEvent[]

  @@index([status])
  @@index([cashRegisterId])
  @@index([openedAt])
  @@index([legacyId])
  @@map("cash_register_shifts")
}

model Payment {
  id                   BigInt        @id @default(autoincrement())
  legacyId             BigInt?       @map("legacy_id")

  // Relaciones
  orderId              BigInt        @map("order_id")
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethodId      BigInt        @map("payment_method_id")
  paymentMethod        PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  shiftId              BigInt        @map("shift_id")
  shift                CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  processedByUserId    BigInt        @map("processed_by_user_id")
  processedByUser      Employee      @relation("PaymentsProcessed", fields: [processedByUserId], references: [id], onDelete: Restrict)

  // Monto
  amount               Decimal       @db.Decimal(10, 2)

  // Metadatos
  referenceNumber      String?       @map("reference_number") @db.VarChar(100)
  notes                String?       @db.Text

  // Fecha
  paidAt               DateTime      @map("paid_at")

  // Timestamps
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([shiftId])
  @@index([paidAt])
  @@index([legacyId])
  @@map("payments")
}

model PaymentMethod {
  id                   BigInt       @id @default(autoincrement())
  legacyCode           String?      @map("legacy_code") @db.VarChar(20)

  code                 String       @unique @db.VarChar(20)
  name                 String       @db.VarChar(100)
  description          String?      @db.Text

  // Control
  isActive             Boolean      @default(true) @map("is_active")
  requiresReference    Boolean      @default(false) @map("requires_reference")
  displayOrder         Int          @default(0) @map("display_order")

  // Timestamps
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  // Relaciones inversas
  payments             Payment[]

  @@index([isActive])
  @@index([legacyCode])
  @@map("payment_methods")
}

model CashDrawerEvent {
  id                   BigInt           @id @default(autoincrement())

  // Relaciones
  shiftId              BigInt           @map("shift_id")
  shift                CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  userId               BigInt           @map("user_id")
  user                 Employee         @relation("DrawerEvents", fields: [userId], references: [id], onDelete: Restrict)

  // Tipo de evento
  eventType            DrawerEventType  @map("event_type")

  // Monto
  amount               Decimal          @db.Decimal(10, 2)

  // Justificación
  reason               String           @db.VarChar(200)
  notes                String?          @db.Text

  // Fecha
  occurredAt           DateTime         @map("occurred_at")

  // Timestamps
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([shiftId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("cash_drawer_events")
}

model Invoice {
  id                   BigInt         @id @default(autoincrement())
  legacyId             BigInt?        @map("legacy_id")
  legacySeries         String?        @map("legacy_series") @db.VarChar(10)

  // Relaciones
  orderId              BigInt         @map("order_id")
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId           BigInt?        @map("customer_id")
  customer             Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Tipo de comprobante
  documentType         DocumentType   @map("document_type")

  // Numeración
  series               String         @db.VarChar(10)
  documentNumber       String         @map("document_number") @db.VarChar(20)

  // Montos
  subtotal             Decimal        @db.Decimal(10, 2)
  taxAmount            Decimal        @map("tax_amount") @db.Decimal(10, 2)
  totalAmount          Decimal        @map("total_amount") @db.Decimal(10, 2)

  // Metadatos
  notes                String?        @db.Text
  issuedAt             DateTime       @map("issued_at")

  // Timestamps
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  @@unique([series, documentNumber], name: "unique_series_number")
  @@index([orderId])
  @@index([customerId])
  @@index([documentType])
  @@index([issuedAt])
  @@index([legacyId])
  @@index([legacySeries])
  @@map("invoices")
}

// ============================================================
// TABLAS AUXILIARES
// ============================================================

model Employee {
  id                   BigInt                @id @default(autoincrement())
  legacyId             BigInt?               @map("legacy_id")

  // Información personal
  employeeCode         String                @unique @map("employee_code") @db.VarChar(20)
  firstName            String                @map("first_name") @db.VarChar(100)
  lastName             String                @map("last_name") @db.VarChar(100)

  // Contacto
  email                String?               @unique @db.VarChar(200)
  phone                String?               @db.VarChar(20)

  // Autenticación
  pinCode              String?               @map("pin_code") @db.VarChar(6)
  passwordHash         String?               @map("password_hash") @db.VarChar(255)

  // Rol
  role                 EmployeeRole

  // Estado
  isActive             Boolean               @default(true) @map("is_active")
  hiredAt              DateTime?             @map("hired_at") @db.Date
  terminatedAt         DateTime?             @map("terminated_at") @db.Date

  // Timestamps
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")

  // Relaciones inversas
  waiterOrders         Order[]               @relation("WaiterOrders")
  shiftsOpened         CashRegisterShift[]   @relation("ShiftsOpened")
  shiftsClosed         CashRegisterShift[]   @relation("ShiftsClosed")
  paymentsProcessed    Payment[]             @relation("PaymentsProcessed")
  cashDrawerEvents     CashDrawerEvent[]     @relation("DrawerEvents")

  @@index([role])
  @@index([isActive])
  @@index([legacyId])
  @@map("employees")
}

model Customer {
  id                   BigInt               @id @default(autoincrement())
  legacyId             BigInt?              @map("legacy_id")

  // Tipo de documento
  documentType         CustomerDocumentType @map("document_type")
  documentNumber       String               @map("document_number") @db.VarChar(20)

  // Información
  name                 String               @db.VarChar(200)
  email                String?              @db.VarChar(200)
  phone                String?              @db.VarChar(20)
  address              String?              @db.Text

  // Control
  isActive             Boolean              @default(true) @map("is_active")

  // Timestamps
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  // Relaciones inversas
  invoices             Invoice[]

  @@unique([documentType, documentNumber], name: "unique_doc")
  @@index([isActive])
  @@index([legacyId])
  @@map("customers")
}
